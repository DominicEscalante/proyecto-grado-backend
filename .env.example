# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL / PostGIS Database Configuration
# Use 'localhost' when running locally on host machine, 'db' is automatically used inside Docker Compose
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=proyecto_grado_db
DB_SSL=false

# Better Auth Configuration
BETTER_AUTH_SECRET=supersecretbetterauthkey_change_in_production_32chars
BETTER_AUTH_URL=http://localhost:3000

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Supabase Storage (set both values to enable cloud uploads; never expose the key in the frontend)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=evidencias-reportes

# Resend Email Service Configuration (Gratis: https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=AMPAR <onboarding@resend.dev>
